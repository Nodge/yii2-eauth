{
	"name": "ptech/yii2-eauth",
	"description": "Yii2 EAuth Extension. EAuth allows to authenticate users with accounts on other websites (Google, Facebook, Twitter, etc).",
	"keywords": ["yii2", "extension", "eauth", "openid", "oauth", "authentication"],
	"homepage": "https://github.com/PyrotechSolutions/yii2-eauth",
	"type": "yii2-extension",
	"license": "New BSD License",
	"authors": [
		{
			"name": "Pyrotech Solutions",
			"email": "developers@pyrotechsolutions.com",
			"homepage": "https://github.com/PyrotechSolutions"
		}
	],
	"support": {
		"source": "https://github.com/PyrotechSolutions/yii2-eauth"
	},
	"autoload": {
		"psr-4": {
			"ptech\\eauth\\": "src/"
		}
	},
    "minimum-stability": "dev",
    "prefer-stable": true,
	"require": {
		"php": ">=5.4.0",
		"lib-curl": "*",
		"yiisoft/yii2": "*",
        "yiisoft/yii2-redis": "~2.0.0",
        "symfony/http-foundation": "^3.2",
        "predis/predis": "^1.1",
		"lusitanian/oauth": "~0.3.0",
		"nodge/lightopenid": "~1.1.0"
	},
	"extra": {
		"bootstrap": "ptech\\eauth\\Bootstrap"
	}
}
